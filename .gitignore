# Build output of `wails build`
build/bin/

# The release zips of make dist
build/dist/

# Generated by wails build and vite; kept out so a clone rebuilds them
frontend/dist/*
!frontend/dist/gitkeep
frontend/wailsjs/
frontend/node_modules/
frontend/package.json.md5

# Coverage and scratch
coverage.out
*.tmp
frontend/test-results/
frontend/playwright-report/

# OS and editors
.DS_Store
.idea/
.vscode/

# Internal working files never ship from a public repository
.claude/
.superpowers/
CLAUDE.md
CONTINUE.md
docs/superpowers/

# A personal library dropped in the repo for a test must never be
# committed; the public example is config.example.toml
library.toml
library.toml.bak
*.local.toml
/icons/
